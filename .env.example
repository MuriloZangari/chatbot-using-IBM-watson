# Identificador estável do “usuário” da sessão (obrigatório na API em várias instâncias). Padrão: poc-local-user
# WATSON_ASSISTANT_USER_ID=poc-local-user
# Sessão atual (opcional; o script de teste aceita --session-id ou esta variável)
# WATSON_ASSISTANT_SESSION_ID=

# Aliases opcionais (mesmo IAM; o código Python usa WATSON_ASSISTANT_*)
# ASSISTANT_APIKEY=
# ASSISTANT_IAM_APIKEY=
# ASSISTANT_URL=
# ASSISTANT_AUTH_TYPE=iam
